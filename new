    <div class="preview" id="preview"></div>

    <script>
      /* ===== 1. HERO SLIDER =====
   Put your image path in `img`, e.g. "images/library.jpg". Empty = grey. */
      const slides = [
        { img: "", title: "Another project", meta: "Branding_2026" },
        { img: "", title: "The Library", meta: "Editorial_2026" },
        { img: "", title: "Notesync", meta: "Branding_2026" },
        { img: "", title: "NOJI", meta: "Branding_2025" },
      ];
      const INTERVAL = 4000; // ms between slides

      const win = document.getElementById("slides");
      const cap = document.getElementById("caption");
      const capText = cap.querySelector("span");
      let cur = 0;

      slides.forEach((s, i) => {
        const d = document.createElement("div");
        d.className = "slide" + (i === 0 ? " active" : "");
        if (s.img) d.style.backgroundImage = `url("${s.img}")`;
        win.appendChild(d);
      });
      const els = [...win.children];
      const setCaption = (i) => {
        capText.innerHTML = `${slides[i].title}<br><em>${slides[i].meta}</em>`;
      };
      setCaption(0);

      function go(next) {
        if (next === cur) return;
        const from = els[cur],
          to = els[next];
        to.style.transition = "none";
        to.classList.remove("leaving");
        to.style.transform = "translateX(100%)";
        void to.offsetWidth;
        to.style.transition = "";
        to.style.transform = "";
        from.classList.remove("active");
        from.classList.add("leaving");
        to.classList.add("active");
        cap.classList.add("fade");
        setTimeout(() => {
          setCaption(next);
          cap.classList.remove("fade");
        }, 350);
        cur = next;
      }
      if (
        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
        slides.length > 1
      )
        setInterval(() => go((cur + 1) % slides.length), INTERVAL);

      /* ===== 2. HOVER PREVIEWS ===== */
      const prev = document.getElementById("preview");
      let px = 0,
        py = 0,
        tx = 0,
        ty = 0,
        raf = null;

      document.querySelectorAll("#works a").forEach((a) => {
        a.addEventListener("mouseenter", () => {
          prev.style.backgroundImage = a.dataset.img
            ? `url("${a.dataset.img}")`
            : "none";
          prev.classList.add("on");
          if (!raf) loop();
        });
        a.addEventListener("mouseleave", () => prev.classList.remove("on"));
      });
      window.addEventListener("mousemove", (e) => {
        tx = e.clientX + 24;
        ty = e.clientY - 75;
      });

      function loop() {
        px += (tx - px) * 0.18;
        py += (ty - py) * 0.18;
        prev.style.left = px + "px";
        prev.style.top = py + "px";
        raf =
          prev.classList.contains("on") || Math.abs(tx - px) > 0.5
            ? requestAnimationFrame(loop)
            : null;
      }
    </script>
  </body>
