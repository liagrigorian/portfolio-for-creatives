/* ===== FONT: change this one line when you pick your font ===== */
:root {
  --font: "Times New Roman", Times, serif;
  --ink: #111;
  --bg: #fcfcfc;
  --grey: #d9d9d9;
  --stripe: #f3f3f3;
  --gap: 8px;
  --pad: 16px;
  --big: clamp(28px, 4.7vw, 56px);
}
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
body {
  font-family: var(--font);
  color: var(--ink);
  background: var(--bg);
  font-size: 11px;
  line-height: 1.2;
  overflow-x: hidden;
}
a {
  color: inherit;
}
em {
  font-style: italic;
}
a.u:hover {
  opacity: 0.5;
}

/* 8-column grid with faint column stripes */
.page {
  position: relative;
  padding: 0 var(--pad) 12px;
}
.page::before {
  content: "";
  position: absolute;
  inset: 0 var(--pad);
  pointer-events: none;
  background: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent calc(12.5% - var(--gap)),
    var(--stripe) calc(12.5% - var(--gap)),
    var(--stripe) 12.5%
  );
}
.grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  column-gap: var(--gap);
}

/* ===== HERO ===== */
.hero {
  padding-top: 16px;
  align-items: start;
}
.name {
  grid-column: 1/4;
  grid-row: 1;
}
.bio {
  grid-column: 2/5;
  grid-row: 2;
  margin-top: 70px;
  max-width: 290px;
}
.now {
  grid-column: 1/4;
  grid-row: 3;
  margin-top: 36px;
}
.more {
  grid-column: 4/6;
  grid-row: 4;
  margin-top: 48px;
}
.slider {
  grid-column: 6/9;
  grid-row: 1/6;
  margin-top: -16px;
}
.slider-window {
  position: relative;
  height: clamp(190px, 28vw, 228px);
  overflow: hidden;
  background: var(--grey);
}
.slide {
  position: absolute;
  inset: 0;
  background: var(--grey) center/cover no-repeat;
  transform: translateX(100%);
  transition: transform 0.9s cubic-bezier(0.77, 0, 0.18, 1);
}
.slide.active {
  transform: translateX(0);
}
.slide.leaving {
  transform: translateX(-100%);
}
.caption {
  margin-top: 6px;
  font-size: 10px;
  min-height: 24px;
}
.caption span {
  display: block;
  transition: opacity 0.4s;
}
.caption.fade span {
  opacity: 0;
}

/* ===== SELECT WORK ===== */
.sec-head {
  margin-top: 70px;
  align-items: start;
}
.sel {
  grid-column: 1/2;
}
.wk {
  grid-column: 2/4;
  margin-top: 10px;
  display: flex;
  gap: 46px;
}
.works {
  font-weight: 400;
  font-size: var(--big);
  line-height: 1.12;
  margin-top: 44px;
  position: relative;
}
.works a {
  text-decoration: none;
  cursor: pointer;
  transition: opacity 0.25s;
}
.works:hover a:not(:hover) {
  opacity: 0.3;
}
.works sup {
  display: inline-block;
  vertical-align: top;
  position: relative;
  top: -3px;
  margin-left: 6px;
  font-size: 10px;
  font-style: italic;
  line-height: 1;
}
.works .sep {
  display: inline-block;
  margin: 0 0.45em 0 0.5em;
}
.tail {
  margin-top: 56px;
  font-size: 10px;
}
.tail span {
  grid-column: 6/9;
}

/* Hover preview that follows the cursor */
.preview {
  position: fixed;
  left: 0;
  top: 0;
  width: 220px;
  height: 150px;
  background: var(--grey) center/cover no-repeat;
  pointer-events: none;
  opacity: 0;
  transform: scale(0.92);
  transition:
    opacity 0.2s,
    transform 0.2s;
  z-index: 50;
}
.preview.on {
  opacity: 1;
  transform: scale(1);
}

/* ===== ARCHIVE ===== */
.arch-head {
  margin-top: 60px;
}
.arch-head .wk {
  margin-top: 0;
}
.thumbs {
  margin-top: 40px;
}
.thumbs div {
  height: clamp(46px, 7.4vw, 70px);
  background: var(--grey) center/cover no-repeat;
}
.info {
  margin-top: 36px;
  row-gap: 12px;
  align-items: start;
}
.links {
  grid-column: 1/3;
  grid-row: 1/4;
  display: flex;
  flex-direction: column;
}
.k1,
.k2 {
  grid-column: 5/6;
}
.v1,
.v2 {
  grid-column: 6/9;
}
.k1,
.v1 {
  grid-row: 1;
}
.v-p {
  grid-column: 6/9;
  grid-row: 2;
  max-width: 330px;
  margin-top: 6px;
}
.k2,
.v2 {
  grid-row: 3;
  margin-top: 12px;
}

/* ===== CONTACT ===== */
.contact {
  position: relative;
  font-size: var(--big);
  line-height: 1;
  margin-top: 48px;
  letter-spacing: -0.01em;
}
.contact a {
  text-decoration: none;
  display: block;
}
.contact a:hover {
  font-style: italic;
}
.contact .r {
  margin-left: 50%;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 720px) {
  :root {
    --big: clamp(26px, 7vw, 40px);
  }
  .page::before {
    background: repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent calc(25% - var(--gap)),
      var(--stripe) calc(25% - var(--gap)),
      var(--stripe) 25%
    );
  }
  .grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .name {
    grid-column: 1/-1;
  }
  .bio {
    grid-column: 1/4;
    margin-top: 64px;
  }
  .now {
    grid-column: 1/4;
    margin-top: 36px;
  }
  .more {
    grid-column: 4/5;
    grid-row: 4;
    margin-top: 24px;
    white-space: nowrap;
  }
  .slider {
    grid-column: 1/-1;
    grid-row: 5;
    margin: 44px 5% 0 12%;
  }
  .sec-head {
    margin-top: 44px;
  }
  .tail span {
    grid-column: 3/5;
  }
  .tail {
    margin-top: 44px;
  }
  .thumbs div:nth-child(n + 5) {
    display: none;
  }
  .thumbs div {
    height: clamp(50px, 15vw, 70px);
  }
  .info {
    margin-top: 30px;
  }
  .k1,
  .k2 {
    grid-column: 1/2;
  }
  .v1,
  .v2,
  .v-p {
    grid-column: 2/5;
  }
  .links {
    grid-column: 4/5;
    grid-row: 4;
    margin-top: 56px;
  }
  .contact .r {
    margin-left: 25%;
  }
  .preview {
    display: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .slide,
  .preview,
  .caption span {
    transition: none;
  }
}
